# 本地开发：复制到 .dev.vars（已被 git 忽略），不要把真实密钥提交到仓库。
# 托管部署：通过 Sites 的环境变量工具配置对应值。
# DeepSeek 官方方案：只需填写 MODEL_API_KEY，搜索和模型共用服务端密钥。
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_API_URL=https://api.deepseek.com/chat/completions
SEARCH_PROVIDER=deepseek
# 可选：搜索使用独立 DeepSeek 密钥；不填写则复用官方模型密钥。
DEEPSEEK_API_KEY=
# 备选搜索：设置 SEARCH_PROVIDER=tavily 后再填写下面的密钥。
TAVILY_API_KEY=
